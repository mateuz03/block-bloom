{
  "name": "block-bloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "build": "tsc && vite build",
    "build:release": "tsc && vite build --mode release",
    "preview": "vite preview --host 127.0.0.1 --port 8080",
    "assets:source": "node scripts/create-capacitor-assets.mjs",
    "android:add": "pnpm build:release && cap add android",
    "android:assets": "pnpm assets:source && capacitor-assets generate --android",
    "android:sync": "pnpm build:release && cap sync android",
    "android:open": "cap open android",
    "android:run": "pnpm android:sync && cap run android",
    "android:bundle": "pnpm android:sync && cd android && gradlew.bat bundleRelease",
    "mobile:notes": "node -e \"console.log('Use pnpm android:sync, test in Android Studio, then generate an Android App Bundle for Play Store.')\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
